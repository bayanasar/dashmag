{
  "$defs": {
    "Arrangement": {
      "additionalProperties": false,
      "description": "Where each part of one job is, in the graph's order of parts.",
      "properties": {
        "job": {
          "type": "string"
        },
        "places": {
          "items": {
            "$ref": "#/$defs/Place"
          },
          "type": "array"
        }
      },
      "required": [
        "job",
        "places"
      ],
      "type": "object"
    },
    "Backend": {
      "description": "A backend a device runs.",
      "oneOf": [
        {
          "enum": [
            "cuda",
            "rocm",
            "mlx"
          ],
          "type": "string"
        },
        {
          "const": "flex",
          "description": "The CPU.",
          "type": "string"
        }
      ]
    },
    "Blob": {
      "additionalProperties": false,
      "description": "Data named by its content's hash, such as weights a part holds.",
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "hash": {
          "type": "string"
        },
        "keep": {
          "$ref": "#/$defs/Trust",
          "description": "The least trust a member must have to hold it, as for weights trained in an earlier job on\ndata kept at that level. The part that holds it is kept at least as far, and so is what\nthat part computes unless it releases it. The graph file must say it: left out, it is\nrefused, as an input's level is."
        }
      },
      "required": [
        "hash",
        "bytes",
        "keep"
      ],
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "description": "One candidate arrangement of the jobs an event touches.",
      "properties": {
        "arrangements": {
          "items": {
            "$ref": "#/$defs/Arrangement"
          },
          "type": "array"
        },
        "band": {
          "description": "The score's band, relative.",
          "format": "double",
          "type": "number"
        },
        "left_out": {
          "description": "The devices given no copy of a replicable part, each with why: a candidate keeps the\ndevices that may take a copy and have room for it, and says why it left out the rest.",
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "$ref": "#/$defs/Removal"
              }
            ],
            "type": "array"
          },
          "type": "array"
        },
        "moves": {
          "items": {
            "$ref": "#/$defs/Move"
          },
          "type": "array"
        },
        "removed": {
          "$ref": "#/$defs/Removal",
          "description": "Why it was removed, if it was."
        },
        "score": {
          "description": "Its predicted score, if it was not removed.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "arrangements",
        "moves",
        "left_out"
      ],
      "type": "object"
    },
    "Chain": {
      "additionalProperties": false,
      "description": "An ordered run of parts, such as a model's blocks, that may sit on one device or be divided\nbetween devices at any boundary between two of them.\n\nEach part's output feeds the next, so an edge joins each part to the next. Dividing a model\nbetween devices is placing a chain's parts on more than one; only the edge at a division\ncrosses between them.",
      "properties": {
        "name": {
          "type": "string"
        },
        "parts": {
          "description": "The parts in order. At least 2, none replicable, none in another chain.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "parts"
      ],
      "type": "object"
    },
    "Change": {
      "description": "What a pool is told: the only ways its state changes.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A job arrives, with the host's stamp on it.",
          "properties": {
            "submit": {
              "additionalProperties": false,
              "properties": {
                "graph": {
                  "$ref": "#/$defs/Graph"
                },
                "stamp": {
                  "$ref": "#/$defs/Stamp"
                }
              },
              "required": [
                "graph",
                "stamp"
              ],
              "type": "object"
            }
          },
          "required": [
            "submit"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A job finishes, or is withdrawn.",
          "properties": {
            "end": {
              "additionalProperties": false,
              "properties": {
                "job": {
                  "type": "string"
                }
              },
              "required": [
                "job"
              ],
              "type": "object"
            }
          },
          "required": [
            "end"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A device joins, with its member's report if the member has one to make.",
          "properties": {
            "join": {
              "additionalProperties": false,
              "properties": {
                "member": {
                  "$ref": "#/$defs/Member"
                },
                "offer": {
                  "$ref": "#/$defs/Offer"
                }
              },
              "required": [
                "offer"
              ],
              "type": "object"
            }
          },
          "required": [
            "join"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A device leaves, or the host takes it back.",
          "properties": {
            "leave": {
              "additionalProperties": false,
              "properties": {
                "device": {
                  "$ref": "#/$defs/DeviceId"
                }
              },
              "required": [
                "device"
              ],
              "type": "object"
            }
          },
          "required": [
            "leave"
          ],
          "type": "object"
        }
      ]
    },
    "Cost": {
      "additionalProperties": false,
      "description": "A part kind's time on a device, per step, at the batch the device's memory allows.",
      "properties": {
        "band": {
          "description": "How far a measurement may be from the prediction, relative: taken from past differences\nbetween the two.",
          "format": "double",
          "type": "number"
        },
        "estimate": {
          "description": "Not measured on this device: estimated from the part's shapes, and so to be probed, not\ntrusted.",
          "type": "boolean"
        },
        "seconds_per_step": {
          "format": "double",
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        }
      },
      "required": [
        "unit",
        "seconds_per_step",
        "band",
        "estimate"
      ],
      "type": "object"
    },
    "DeviceId": {
      "additionalProperties": false,
      "description": "A device: its member, and its index on that member.",
      "properties": {
        "index": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "member": {
          "type": "string"
        }
      },
      "required": [
        "member",
        "index"
      ],
      "type": "object"
    },
    "Dtype": {
      "description": "What an edge carries: a tensor's element type, or opaque bytes (an encoded image, a record).",
      "enum": [
        "f64",
        "f32",
        "bf16",
        "f16",
        "i64",
        "i32",
        "i8",
        "u8",
        "bool",
        "bytes"
      ],
      "type": "string"
    },
    "Edge": {
      "additionalProperties": false,
      "description": "Data that moves from an input or a part to a part, or out of the job.",
      "properties": {
        "bytes": {
          "description": "Its size. 0 is taken: an edge may carry nothing but the order between two parts.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "dtype": {
          "$ref": "#/$defs/Dtype",
          "description": "What the data is: a tensor's element type, or opaque bytes."
        },
        "from": {
          "description": "An input or a part.",
          "type": "string"
        },
        "note": {
          "description": "Free text: the author's reasons. mag never reads it.",
          "type": "string"
        },
        "release": {
          "$ref": "#/$defs/Trust",
          "description": "The level the producing part releases this output to, if it releases it: the output is\nthen kept at that level where what the part read is kept higher. A release never keeps\ndata higher than it is. Only a part releases; an input is never released."
        },
        "to": {
          "description": "A part, or `None` for a result of the job.",
          "type": "string"
        }
      },
      "required": [
        "from",
        "dtype",
        "bytes"
      ],
      "type": "object"
    },
    "Entry": {
      "additionalProperties": false,
      "description": "One change a pool took, at the time it was told of it, with the record the loop made of it.",
      "properties": {
        "at": {
          "description": "Seconds, as the pool was told: finite.",
          "format": "double",
          "type": "number"
        },
        "change": {
          "$ref": "#/$defs/Change"
        },
        "record": {
          "$ref": "#/$defs/Record"
        }
      },
      "required": [
        "at",
        "change",
        "record"
      ],
      "type": "object"
    },
    "Event": {
      "description": "What the loop runs on.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A job is submitted.",
          "properties": {
            "arrival": {
              "additionalProperties": false,
              "properties": {
                "job": {
                  "type": "string"
                }
              },
              "required": [
                "job"
              ],
              "type": "object"
            }
          },
          "required": [
            "arrival"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A job finishes, or is withdrawn.",
          "properties": {
            "end": {
              "additionalProperties": false,
              "properties": {
                "job": {
                  "type": "string"
                }
              },
              "required": [
                "job"
              ],
              "type": "object"
            }
          },
          "required": [
            "end"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A device joins the pool.",
          "properties": {
            "join": {
              "additionalProperties": false,
              "properties": {
                "device": {
                  "$ref": "#/$defs/DeviceId"
                }
              },
              "required": [
                "device"
              ],
              "type": "object"
            }
          },
          "required": [
            "join"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A device leaves, or the host takes it back.",
          "properties": {
            "leave": {
              "additionalProperties": false,
              "properties": {
                "device": {
                  "$ref": "#/$defs/DeviceId"
                }
              },
              "required": [
                "device"
              ],
              "type": "object"
            }
          },
          "required": [
            "leave"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A device's offer changes.",
          "properties": {
            "offer_changed": {
              "additionalProperties": false,
              "properties": {
                "device": {
                  "$ref": "#/$defs/DeviceId"
                }
              },
              "required": [
                "device"
              ],
              "type": "object"
            }
          },
          "required": [
            "offer_changed"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A measured cost leaves its predicted band.",
          "properties": {
            "drift": {
              "additionalProperties": false,
              "properties": {
                "job": {
                  "type": "string"
                },
                "part": {
                  "type": "string"
                }
              },
              "required": [
                "job",
                "part"
              ],
              "type": "object"
            }
          },
          "required": [
            "drift"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A job's deadline comes at risk.",
          "properties": {
            "deadline_at_risk": {
              "additionalProperties": false,
              "properties": {
                "job": {
                  "type": "string"
                }
              },
              "required": [
                "job"
              ],
              "type": "object"
            }
          },
          "required": [
            "deadline_at_risk"
          ],
          "type": "object"
        }
      ]
    },
    "Graph": {
      "additionalProperties": false,
      "description": "One submitted job.\n\nEvery name in a graph (inputs, parts and chains together) is unique, and edges and chains\nrefer to inputs and parts by name. [`Graph::check`] says whether a graph is well formed.",
      "properties": {
        "chains": {
          "default": [],
          "description": "Ordered runs of parts that may be divided between devices at any part boundary.",
          "items": {
            "$ref": "#/$defs/Chain"
          },
          "type": "array"
        },
        "edges": {
          "default": [],
          "description": "What moves between inputs and parts, and out of the job.",
          "items": {
            "$ref": "#/$defs/Edge"
          },
          "type": "array"
        },
        "inputs": {
          "default": [],
          "description": "What the job reads from outside its parts.",
          "items": {
            "$ref": "#/$defs/Input"
          },
          "type": "array"
        },
        "job": {
          "$ref": "#/$defs/Job",
          "description": "The job's name, its weight and its need."
        },
        "note": {
          "description": "Free text: the author's reasons. mag never reads it.",
          "type": "string"
        },
        "parts": {
          "description": "The pieces mag places. At least one.",
          "items": {
            "$ref": "#/$defs/Part"
          },
          "type": "array"
        }
      },
      "required": [
        "job",
        "parts"
      ],
      "type": "object"
    },
    "Header": {
      "additionalProperties": false,
      "description": "The header's fields after `format` and `version`.",
      "properties": {
        "at": {
          "description": "The pool's time when it began, in seconds.",
          "format": "double",
          "type": "number"
        },
        "follows": {
          "default": null,
          "description": "The name of the ledger this one follows; left out for a first ledger.",
          "type": "string"
        },
        "format": {
          "const": "mag-ledger"
        },
        "members": {
          "description": "The members the pool began with, as they were given to it.",
          "items": {
            "$ref": "#/$defs/Member"
          },
          "type": "array"
        },
        "offers": {
          "description": "The offers the pool began with, in the order of the devices' ids.",
          "items": {
            "$ref": "#/$defs/Offer"
          },
          "type": "array"
        },
        "version": {
          "const": 2
        },
        "written_by": {
          "default": null,
          "description": "The version of `mag-mortar` that began the ledger.",
          "type": "string"
        }
      },
      "required": [
        "format",
        "version",
        "at",
        "members",
        "offers"
      ],
      "type": "object"
    },
    "Input": {
      "additionalProperties": false,
      "description": "Data a job reads from outside its parts. The graph file names an input and its level; which\ndata it is gets bound at submission, where the pool can check the data's own level against its\nrecord of it. The level here is only as good as that binding.",
      "properties": {
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "keep": {
          "$ref": "#/$defs/Trust",
          "description": "The least trust a member must have to hold it, or anything computed from it unless a part\nreleases that. The graph file must say it, `outside` included: left out, it is refused, so\nthat forgetting it never lets an input move."
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "bytes",
        "keep"
      ],
      "type": "object"
    },
    "Job": {
      "additionalProperties": false,
      "description": "A job's name, how much it weighs against the other jobs in the pool, and what it needs.\n\nBeyond its need a job wants to run as fast as it can: when jobs share the pool, an\narrangement is judged by the sum over jobs of priority times each job's rate.",
      "properties": {
        "name": {
          "type": "string"
        },
        "need": {
          "$ref": "#/$defs/Need",
          "default": {}
        },
        "note": {
          "description": "Free text: the author's reasons. mag never reads it.",
          "type": "string"
        },
        "priority": {
          "description": "The job's weight against other jobs. At least 1.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "priority"
      ],
      "type": "object"
    },
    "Mark": {
      "description": "How a part may be spread over devices.",
      "oneOf": [
        {
          "const": "atomic",
          "description": "One copy, on one device.",
          "type": "string"
        },
        {
          "const": "replicable",
          "description": "As many copies as there are devices to hold them, each pulling items from one queue.",
          "type": "string"
        }
      ]
    },
    "Member": {
      "additionalProperties": false,
      "description": "A machine in the pool, running `mag-mar`: one lease of the host's.",
      "properties": {
        "give_back_seconds": {
          "description": "Seconds within which the member gives a device back when the host takes it back. Finite,\nand not below 0: a member given 0 gives its devices back at once, with no time to say it\nleaves, as a host that takes them back without warning allows.",
          "format": "double",
          "minimum": 0.0,
          "type": "number"
        },
        "name": {
          "description": "A DNS name in lower case, as [`is_member_name`] takes it: the member's certificate\ncarries it so.",
          "maxLength": 253,
          "minLength": 1,
          "pattern": "^(?!(.*\\.)?[0-9]+$)[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$",
          "type": "string"
        },
        "trust": {
          "$ref": "#/$defs/Trust",
          "description": "How far the host trusts it. Nothing kept at a higher level is placed on its devices."
        }
      },
      "required": [
        "name",
        "trust",
        "give_back_seconds"
      ],
      "type": "object"
    },
    "Move": {
      "description": "How a candidate changes the current arrangement.",
      "oneOf": [
        {
          "const": "fit",
          "description": "Waiting parts onto devices with memory free.",
          "type": "string"
        },
        {
          "const": "spread",
          "description": "A chain onto more devices, or more copies of a replicable part.",
          "type": "string"
        },
        {
          "const": "share",
          "description": "Parts into the memory another job leaves free on a device.",
          "type": "string"
        },
        {
          "const": "squeeze",
          "description": "A running job's parts off a device, onto fewer devices or a smaller variant.",
          "type": "string"
        },
        {
          "const": "wait",
          "description": "The arrival, or a job of lower priority, left in the queue.",
          "type": "string"
        }
      ]
    },
    "Need": {
      "additionalProperties": false,
      "description": "What an arrangement must give a job. Each field is optional, and a job with neither only\nwants to run as fast as its priority allows.",
      "properties": {
        "deadline_seconds": {
          "description": "Seconds from its submission by which it must finish. Finite and above 0.",
          "format": "double",
          "type": "number"
        },
        "rate_per_second": {
          "description": "The rate it must sustain, in its own steps per second (items, tokens or optimiser\nsteps): a service's need. Finite and above 0.",
          "format": "double",
          "type": "number"
        }
      },
      "type": "object"
    },
    "Offer": {
      "additionalProperties": false,
      "description": "What a device gives the pool now.",
      "properties": {
        "backend": {
          "$ref": "#/$defs/Backend"
        },
        "costs": {
          "description": "Its time per step for each part kind it has run or estimated.",
          "items": {
            "$ref": "#/$defs/Cost"
          },
          "type": "array"
        },
        "device": {
          "$ref": "#/$defs/DeviceId"
        },
        "dtypes": {
          "description": "The dtypes it computes in.",
          "items": {
            "$ref": "#/$defs/Dtype"
          },
          "type": "array"
        },
        "memory_bytes": {
          "description": "The memory it can give: what is free of anything else holding it.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "tolerances": {
          "description": "The tolerance classes its measured bounds meet.",
          "items": {
            "$ref": "#/$defs/Tolerance"
          },
          "type": "array"
        }
      },
      "required": [
        "device",
        "backend",
        "memory_bytes",
        "tolerances",
        "dtypes",
        "costs"
      ],
      "type": "object"
    },
    "Part": {
      "additionalProperties": false,
      "description": "The smallest piece mag places: a unit with the weights it holds, the memory it needs, and\nwhere it can stop.",
      "properties": {
        "mark": {
          "$ref": "#/$defs/Mark",
          "default": "atomic"
        },
        "memory_bytes": {
          "description": "The memory it needs on its device, weights and working memory together. Above 0: memory\ndecides where a part fits, and 0 would say it fits anywhere.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "note": {
          "description": "Free text: the author's reasons. mag never reads it.",
          "type": "string"
        },
        "pin": {
          "$ref": "#/$defs/Pin",
          "description": "A member or a backend it must run on."
        },
        "step": {
          "$ref": "#/$defs/Step",
          "description": "Where the part can stop with its state written out, to move or to make way."
        },
        "tolerance": {
          "$ref": "#/$defs/Tolerance",
          "description": "The numerics it accepts, which decide the devices it may run on."
        },
        "unit": {
          "$ref": "#/$defs/Unit",
          "description": "The function the part runs, already built into each member's binary."
        },
        "weights": {
          "default": [],
          "description": "The weights it holds, fetched once per member and kept.",
          "items": {
            "$ref": "#/$defs/Blob"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "unit",
        "step",
        "memory_bytes",
        "tolerance"
      ],
      "type": "object"
    },
    "Pin": {
      "description": "Where a part must run.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "On this member.",
          "properties": {
            "member": {
              "type": "string"
            }
          },
          "required": [
            "member"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "On a device of this backend, so that results stay comparable.",
          "properties": {
            "backend": {
              "$ref": "#/$defs/Backend"
            }
          },
          "required": [
            "backend"
          ],
          "type": "object"
        }
      ]
    },
    "Place": {
      "description": "Where a part is.",
      "oneOf": [
        {
          "const": "waiting",
          "description": "Not placed: its job waits.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "On one device.",
          "properties": {
            "on": {
              "$ref": "#/$defs/DeviceId"
            }
          },
          "required": [
            "on"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A replicable part's copies, one on each device, each pulling items from one queue.",
          "properties": {
            "copies": {
              "items": {
                "$ref": "#/$defs/DeviceId"
              },
              "type": "array"
            }
          },
          "required": [
            "copies"
          ],
          "type": "object"
        }
      ]
    },
    "Record": {
      "additionalProperties": false,
      "description": "One run of the placement loop: the event, every candidate, and the choice.",
      "properties": {
        "candidates": {
          "items": {
            "$ref": "#/$defs/Candidate"
          },
          "type": "array"
        },
        "chosen": {
          "description": "The candidate committed, by index; `None` when nothing moved.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "event": {
          "$ref": "#/$defs/Event"
        },
        "greedy": {
          "description": "Whether the candidates were too many to list and were generated greedily instead.",
          "type": "boolean"
        },
        "lowered": {
          "description": "Members whose trust this event lowered below an earlier report's: of two reports for one\nmember, the lower trust stands.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "event",
        "candidates",
        "greedy",
        "lowered"
      ],
      "type": "object"
    },
    "Removal": {
      "description": "Why a candidate was removed before it was scored, or why a device was given no copy of a\nreplicable part.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "The device is not in the pool.",
          "properties": {
            "no_device": {
              "additionalProperties": false,
              "properties": {
                "device": {
                  "$ref": "#/$defs/DeviceId"
                }
              },
              "required": [
                "device"
              ],
              "type": "object"
            }
          },
          "required": [
            "no_device"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The parts placed on a device need more memory than it offers, or a copy does not fit\nbeside them.",
          "properties": {
            "memory": {
              "additionalProperties": false,
              "properties": {
                "device": {
                  "$ref": "#/$defs/DeviceId"
                }
              },
              "required": [
                "device"
              ],
              "type": "object"
            }
          },
          "required": [
            "memory"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The device's bounds do not meet the part's tolerance class.",
          "properties": {
            "tolerance": {
              "additionalProperties": false,
              "properties": {
                "device": {
                  "$ref": "#/$defs/DeviceId"
                },
                "part": {
                  "type": "string"
                }
              },
              "required": [
                "part",
                "device"
              ],
              "type": "object"
            }
          },
          "required": [
            "tolerance"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The device does not compute in a dtype one of the part's edges carries.",
          "properties": {
            "dtype": {
              "additionalProperties": false,
              "properties": {
                "device": {
                  "$ref": "#/$defs/DeviceId"
                },
                "part": {
                  "type": "string"
                }
              },
              "required": [
                "part",
                "device"
              ],
              "type": "object"
            }
          },
          "required": [
            "dtype"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The part is pinned elsewhere.",
          "properties": {
            "pin": {
              "additionalProperties": false,
              "properties": {
                "device": {
                  "$ref": "#/$defs/DeviceId"
                },
                "part": {
                  "type": "string"
                }
              },
              "required": [
                "part",
                "device"
              ],
              "type": "object"
            }
          },
          "required": [
            "pin"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The part carries data kept at a level above the trust of the device's member: `keep` is\nthe part's level, `trust` the member's (`outside` for a member the pool does not know).",
          "properties": {
            "guard": {
              "additionalProperties": false,
              "properties": {
                "device": {
                  "$ref": "#/$defs/DeviceId"
                },
                "keep": {
                  "$ref": "#/$defs/Trust"
                },
                "part": {
                  "type": "string"
                },
                "trust": {
                  "$ref": "#/$defs/Trust"
                }
              },
              "required": [
                "part",
                "device",
                "keep",
                "trust"
              ],
              "type": "object"
            }
          },
          "required": [
            "guard"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The device is not among those the job's stamp allows.",
          "properties": {
            "stamp": {
              "additionalProperties": false,
              "properties": {
                "device": {
                  "$ref": "#/$defs/DeviceId"
                },
                "job": {
                  "type": "string"
                }
              },
              "required": [
                "job",
                "device"
              ],
              "type": "object"
            }
          },
          "required": [
            "stamp"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The job's need is not met: its rate is below the rate it declared.",
          "properties": {
            "need": {
              "additionalProperties": false,
              "properties": {
                "job": {
                  "type": "string"
                }
              },
              "required": [
                "job"
              ],
              "type": "object"
            }
          },
          "required": [
            "need"
          ],
          "type": "object"
        }
      ]
    },
    "Stamp": {
      "additionalProperties": false,
      "description": "The host's stamp on a submission: its one handle on a job, since priority between jobs is\ndecided inside the pool. Each field may be left out, and a stamp with none puts no bound on\nthe job: as a program that submits its own job to a pool of its own stamps it.",
      "properties": {
        "by": {
          "description": "Who submitted the job, in the host's words. mag never reads it; the ledger keeps it.",
          "type": "string"
        },
        "devices": {
          "description": "The devices the job may use. Left out, every device in the pool, as it is and as devices\njoin. Given, at least one.",
          "items": {
            "$ref": "#/$defs/DeviceId"
          },
          "type": "array"
        },
        "priority_ceiling": {
          "description": "The highest priority the job may have: a graph that asks for more is given this. At\nleast 1.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Step": {
      "description": "The point where a part can stop with its state written out.",
      "oneOf": [
        {
          "const": "item",
          "description": "After each item, as a map stops.",
          "type": "string"
        },
        {
          "const": "token",
          "description": "After each token, as a decoder stops.",
          "type": "string"
        },
        {
          "const": "optimiser_step",
          "description": "After each optimiser step, as a learner stops.",
          "type": "string"
        },
        {
          "const": "round",
          "description": "After each round of a loop.",
          "type": "string"
        }
      ]
    },
    "Tolerance": {
      "description": "The numerics a part accepts. A device takes the part only if its measured bounds for the\npart's operations meet it.",
      "oneOf": [
        {
          "enum": [
            "f32",
            "bf16",
            "int8"
          ],
          "type": "string"
        },
        {
          "const": "exact",
          "description": "The reference's bits.",
          "type": "string"
        }
      ]
    },
    "Trust": {
      "description": "How far a machine is trusted, and how far data must be kept, in order: `outside < site <\nowner`. A member is trusted at a level; an input or a blob is kept at a level, and is placed\nonly on a member trusted at least as far.\n\nThe host gives each member its level, and mag judges no one: what a level means is the\nhost's. As a rule of thumb, `owner` is the owner's own machines, `site` a machine inside the\nowner's site that is not the owner's, and `outside` anything else, a rented machine among\nthem.",
      "oneOf": [
        {
          "const": "outside",
          "description": "Trusted with what anyone may hold.",
          "type": "string"
        },
        {
          "const": "site",
          "description": "Inside the owner's site, but not the owner's.",
          "type": "string"
        },
        {
          "const": "owner",
          "description": "The owner's own.",
          "type": "string"
        }
      ]
    },
    "Unit": {
      "additionalProperties": false,
      "description": "A named, versioned function.",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    }
  },
