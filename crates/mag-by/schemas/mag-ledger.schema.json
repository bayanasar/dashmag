  "anyOf": [
    {
      "$ref": "#/$defs/Header"
    },
    {
      "$ref": "#/$defs/Entry"
    }
  ],
  "description": "One line of a ledger, for its schema.",
  "title": "mag-ledger, version 2: one line"
}
