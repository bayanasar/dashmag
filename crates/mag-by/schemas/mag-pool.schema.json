{
  "$defs": {
    "Arrangement": {
      "additionalProperties": false,
      "description": "Where each part of one job is, in the graph's order of parts.",
      "properties": {
        "job": {
          "type": "string"
        },
        "places": {
          "items": {
            "$ref": "#/$defs/Place"
          },
          "type": "array"
        }
      },
      "required": [
        "job",
        "places"
      ],
      "type": "object"
    },
    "Backend": {
      "description": "A backend a device runs.",
      "oneOf": [
        {
          "enum": [
            "cuda",
            "rocm",
            "mlx"
          ],
          "type": "string"
        },
        {
          "const": "flex",
          "description": "The CPU.",
          "type": "string"
        }
      ]
    },
    "Cost": {
      "additionalProperties": false,
      "description": "A part kind's time on a device, per step, at the batch the device's memory allows.",
      "properties": {
        "band": {
          "description": "How far a measurement may be from the prediction, relative: taken from past differences\nbetween the two.",
          "format": "double",
          "type": "number"
        },
        "estimate": {
          "description": "Not measured on this device: estimated from the part's shapes, and so to be probed, not\ntrusted.",
          "type": "boolean"
        },
        "seconds_per_step": {
          "format": "double",
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/Unit"
        }
      },
      "required": [
        "unit",
        "seconds_per_step",
        "band",
        "estimate"
      ],
      "type": "object"
    },
    "DeviceId": {
      "additionalProperties": false,
      "description": "A device: its member, and its index on that member.",
      "properties": {
        "index": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "member": {
          "type": "string"
        }
      },
      "required": [
        "member",
        "index"
      ],
      "type": "object"
    },
    "Dtype": {
      "description": "What an edge carries: a tensor's element type, or opaque bytes (an encoded image, a record).",
      "enum": [
        "f64",
        "f32",
        "bf16",
        "f16",
        "i64",
        "i32",
        "i8",
        "u8",
        "bool",
        "bytes"
      ],
      "type": "string"
    },
    "Format": {
      "additionalProperties": false,
      "description": "A file format a pool reads, at the version it reads.",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "Held": {
      "additionalProperties": false,
      "description": "A job a pool holds, as the pool's description shows it.",
      "properties": {
        "arrangement": {
          "$ref": "#/$defs/Arrangement",
          "description": "Where its parts are. The job's name is the arrangement's."
        },
        "priority": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "waited_seconds": {
          "description": "Seconds it has waited since it arrived or last lost its place: 0 while it is placed.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "arrangement",
        "priority",
        "waited_seconds"
      ],
      "type": "object"
    },
    "Member": {
      "additionalProperties": false,
      "description": "A machine in the pool, running `mag-mar`.",
      "properties": {
        "give_back_seconds": {
          "description": "Seconds within which the member gives a device back when its owner wants it.",
          "format": "double",
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "remote": {
          "description": "Outside the owner's own machines, as a rented GPU is. Nothing local-only is placed on a\nremote member's devices.",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "remote",
        "give_back_seconds"
      ],
      "type": "object"
    },
    "Offer": {
      "additionalProperties": false,
      "description": "What a device gives the pool now.",
      "properties": {
        "backend": {
          "$ref": "#/$defs/Backend"
        },
        "costs": {
          "description": "Its time per step for each part kind it has run or estimated.",
          "items": {
            "$ref": "#/$defs/Cost"
          },
          "type": "array"
        },
        "device": {
          "$ref": "#/$defs/DeviceId"
        },
        "dtypes": {
          "description": "The dtypes it computes in.",
          "items": {
            "$ref": "#/$defs/Dtype"
          },
          "type": "array"
        },
        "memory_bytes": {
          "description": "The memory it can give: what is free of anything else holding it.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "tolerances": {
          "description": "The tolerance classes its measured bounds meet.",
          "items": {
            "$ref": "#/$defs/Tolerance"
          },
          "type": "array"
        }
      },
      "required": [
        "device",
        "backend",
        "memory_bytes",
        "tolerances",
        "dtypes",
        "costs"
      ],
      "type": "object"
    },
    "Place": {
      "description": "Where a part is.",
      "oneOf": [
        {
          "const": "waiting",
          "description": "Not placed: its job waits.",
          "type": "string"
        },
        {
          "additionalProperties": false,
          "description": "On one device.",
          "properties": {
            "on": {
              "$ref": "#/$defs/DeviceId"
            }
          },
          "required": [
            "on"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A replicable part's copies, one on each device, each pulling items from one queue.",
          "properties": {
            "copies": {
              "items": {
                "$ref": "#/$defs/DeviceId"
              },
              "type": "array"
            }
          },
          "required": [
            "copies"
          ],
          "type": "object"
        }
      ]
    },
    "Tolerance": {
      "description": "The numerics a part accepts. A device takes the part only if its measured bounds for the\npart's operations meet it.",
      "oneOf": [
        {
          "enum": [
            "f32",
            "bf16",
            "int8"
          ],
          "type": "string"
        },
        {
          "const": "exact",
          "description": "The reference's bits.",
          "type": "string"
        }
      ]
    },
    "Unit": {
      "additionalProperties": false,
      "description": "A named, versioned function.",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The pool as an author sees it, as one virtual device: its members and what each device\noffers, where each job it holds is and how long each waiting one has waited, and the file\nformats it reads. An author reads it before writing a graph.",
  "properties": {
    "at": {
      "description": "The pool's time, in seconds: the latest it has been told of.",
      "format": "double",
      "type": "number"
    },
    "format": {
      "const": "mag-pool"
    },
    "formats": {
      "description": "The file formats it reads.",
      "items": {
        "$ref": "#/$defs/Format"
      },
      "type": "array"
    },
    "jobs": {
      "description": "The jobs it holds, in the order they arrived.",
      "items": {
        "$ref": "#/$defs/Held"
      },
      "type": "array"
    },
    "members": {
      "description": "Its members, each with the stricter of the marks it was reported with.",
      "items": {
        "$ref": "#/$defs/Member"
      },
      "type": "array"
    },
    "offers": {
      "description": "What each device offers, with the costs measured or estimated on it, in the order of the\ndevices' ids.",
      "items": {
        "$ref": "#/$defs/Offer"
      },
      "type": "array"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "format",
    "version",
    "at",
    "members",
    "offers",
    "jobs",
    "formats"
  ],
  "title": "mag-pool, version 1",
  "type": "object"
}
